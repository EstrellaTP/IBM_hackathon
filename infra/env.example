# Copy to infra/.env (gitignored) and fill in. Every variable has a safe default in
# the code except the secrets marked REQUIRED.

# --- common -----------------------------------------------------------------
LOG_LEVEL=INFO
SERVICE_VERSION=0.1.0

# --- service URLs on the compose network (defaults match docker-compose.yml) ---
DETECTOR_URL=http://detector:8000
STORE_URL=http://store:8000

# --- access control (issue #14) ------------------------------------------------
# REQUIRED. Secret that signs session tokens (HS256). Generated by scripts/deploy_vm.sh.
AUTH_TOKEN_SECRET=
# REQUIRED. Shared key that bands/simulator send as X-Device-Key with signal batches.
DEVICE_KEY=
# Comma-separated browser origins allowed to call the API from another site, e.g. the
# Vercel deployment of frontend/. Empty = same origin only.
ALLOWED_ORIGINS=
AUTH_USERS_PATH=/etc/holter/users.json

# --- store ----------------------------------------------------------------------
# REQUIRED. Fernet key for field encryption at rest. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORE_ENCRYPTION_KEY=
STORE_DB_PATH=/data/holter.sqlite3

# --- detector (services/detector/core.py DetectorConfig; tuned in F1-ML-02) -------
DETECTOR_WINDOW_SECONDS=60
DETECTOR_STEP_SECONDS=10
DETECTOR_WARMUP_WINDOWS=30
DETECTOR_BASELINE_ALPHA=0.02
DETECTOR_HR_Z_THRESHOLD=2.0
DETECTOR_HR_Z_THRESHOLD_WITHOUT_EDA=2.5
DETECTOR_HR_Z_EXTREME=6.0
DETECTOR_ACTIVITY_Z_MAX=0.5
DETECTOR_MIN_STD_HR_BPM=2.0
DETECTOR_MIN_STD_ACTIVITY_G=0.005
DETECTOR_MIN_STD_EDA_US=0.05
DETECTOR_COOLDOWN_SECONDS=600
DETECTOR_MIN_SAMPLES_PER_WINDOW=10
DETECTOR_MOVEMENT_LOOKBACK_SECONDS=180
DETECTOR_EDA_Z_MIN=1.0
