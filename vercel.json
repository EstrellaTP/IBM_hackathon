{
  "version": 2,
  "builds": [
    { "src": "services/ingest_api/main.py", "use": "@vercel/python" },
    { "src": "services/detector/main.py", "use": "@vercel/python" },
    { "src": "services/store/main.py", "use": "@vercel/python" },
    { "src": "services/suspicion_module/main.py", "use": "@vercel/python" },
    { "src": "services/evidence_api/main.py", "use": "@vercel/python" },
    { "src": "frontend/**", "use": "@vercel/static" }
  ],
  "rewrites": [
    { "source": "/api/v1/ingest/(.*)", "destination": "/services/ingest_api/main.py" },
    { "source": "/api/v1/detector/(.*)", "destination": "/services/detector/main.py" },
    { "source": "/api/v1/store/(.*)", "destination": "/services/store/main.py" },
    { "source": "/api/v1/suspicion/(.*)", "destination": "/services/suspicion_module/main.py" },
    { "source": "/api/v1/evidence/(.*)", "destination": "/services/evidence_api/main.py" },
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ]
}
